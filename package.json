{
  "name": "financial-shock-preview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:mobile": "npm --prefix apps/mobile run start",
    "dev:api": "python -m uvicorn app.main:app --app-dir apps/api --reload --host 0.0.0.0 --port 8000",
    "lint": "npm run lint:mobile && npm run lint:api",
    "lint:mobile": "npm --prefix apps/mobile run lint",
    "lint:api": "python -m ruff check apps/api",
    "typecheck": "npm --prefix apps/mobile run typecheck",
    "test": "python -m pytest -c apps/api/pyproject.toml apps/api/tests",
    "check": "npm run lint && npm run typecheck && npm test"
  }
}
