# Values are read from the process environment; this file documents local defaults.
APP_ENV=development
# Native Flutter requests do not need CORS. Add comma-separated browser origins only if used.
CORS_ORIGINS=
STOCK_DATA_PROVIDER=naver
# Keep template for a no-secret fallback, or set openai_compatible with all values below.
LLM_PROVIDER=template
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
